# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Pure-OCaml QUIC v1 engine, sans-io (unreleased)"
description: """
A sans-io implementation of QUIC version 1 (RFC 9000/9001/9002) with
unreliable datagrams (RFC 9221) and reliable stream resets
(draft-ietf-quic-reliable-stream-reset), written in OCaml on
mirage-crypto. No sockets, clocks, effects or C library dependencies;
drive it from any runtime. Unreleased while interop hardening is in
progress."""
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "MIT"
homepage: "https://github.com/thevilledev/ocaml-webtransport"
bug-reports: "https://github.com/thevilledev/ocaml-webtransport/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16"}
  "bigstringaf"
  "digestif"
  "kdf"
  "mirage-crypto"
  "mirage-crypto-ec"
  "mirage-crypto-pk"
  "mirage-crypto-rng"
  "x509"
  "eqaf"
  "ptime"
  "alcotest" {with-test}
  "crowbar" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/thevilledev/ocaml-webtransport.git"
