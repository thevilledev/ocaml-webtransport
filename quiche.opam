# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Bindings to the Cloudflare quiche QUIC library"
description: """
Thin, hand-written C stub bindings to libquiche, Cloudflare's QUIC
implementation. Requires the quiche C library: `brew install
cloudflare-quiche` on macOS, or build cloudflare/quiche with `cargo build
--release --features ffi,qlog,pkg-config-meta` and point PKG_CONFIG_PATH at
the build directory (or set QUICHE_INCLUDE_DIR/QUICHE_LIB_DIR)."""
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "MIT"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16"}
  "bigstringaf"
  "dune-configurator"
  "conf-pkg-config" {build}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
