opam-version: "2.0"
synopsis: "Eio runtime for webtransport"
description: """
Eio-based driver for the webtransport sans-io core: UDP socket handling,
timers, fibers, and a Session/Stream API where WebTransport streams are
exposed as Eio flows."""
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "MIT"
homepage: "https://github.com/thevilledev/ocaml-webtransport"
bug-reports: "https://github.com/thevilledev/ocaml-webtransport/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16"}
  "webtransport"
  "webtransport-quiche" {with-test}
  "eio" {>= "1.2"}
  "eio_main" {with-test}
  "mtime"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/thevilledev/ocaml-webtransport.git"
