opam-version: "2.0"
synopsis: "Lwt runtime for webtransport"
description: """
Lwt-based driver for the webtransport sans-io core: UDP socket handling,
timers, and a Session/Stream API mirroring webtransport-eio."""
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "MIT"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16"}
  "webtransport"
  "webtransport-quiche"
  "lwt" {>= "5.7"}
  "bigstringaf"
  "mtime"
  "ipaddr"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
