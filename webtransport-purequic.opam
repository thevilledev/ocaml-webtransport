# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Pure-OCaml QUIC backend for webtransport (unreleased)"
description: """
Implements the webtransport Quic_backend.S interface on top of the
purequic engine: a QUIC backend with no C library or Rust toolchain
requirement. Unreleased while interop hardening is in progress."""
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "MIT"
homepage: "https://github.com/thevilledev/ocaml-webtransport"
bug-reports: "https://github.com/thevilledev/ocaml-webtransport/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16"}
  "purequic"
  "webtransport"
  "mirage-crypto-rng"
  "ca-certs"
  "ptime"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/thevilledev/ocaml-webtransport.git"
