opam-version: "2.0"
synopsis: "Quiche QUIC backend for webtransport"
description: """
Implements the webtransport Quic_backend.S interface on top of the quiche
bindings. This is the default QUIC engine for webtransport-eio and
webtransport-lwt."""
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "MIT"
homepage: "https://github.com/thevilledev/ocaml-webtransport"
bug-reports: "https://github.com/thevilledev/ocaml-webtransport/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16"}
  "quiche"
  "webtransport"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/thevilledev/ocaml-webtransport.git"
