# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "WebTransport over HTTP/3: sans-io protocol core"
description: """
A sans-io implementation of WebTransport over HTTP/3
(draft-ietf-webtrans-http3): session establishment via HTTP/3 extended
CONNECT, WebTransport streams and datagrams, capsules, and the minimal
HTTP/3 + QPACK subset WebTransport needs. Contains no sockets, clocks or
concurrency; pair it with webtransport-eio or webtransport-lwt and a QUIC
backend such as webtransport-quiche."""
maintainer: ["Ville Vesilehto <ville@vesilehto.fi>"]
authors: ["Ville Vesilehto <ville@vesilehto.fi>"]
license: "MIT"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.16"}
  "bigstringaf"
  "x509"
  "mirage-crypto-ec"
  "mirage-crypto-rng"
  "ptime"
  "digestif"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
